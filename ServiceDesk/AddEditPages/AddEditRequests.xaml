<Page x:Class="ServiceDesk.AddEditPages.AddEditRequests"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ServiceDesk.AddEditPages"
      mc:Ignorable="d" 
              d:DesignHeight="380" d:DesignWidth="800"
Title="AddEditRequest">

    <Grid Margin="0,0,0,0" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CreatedByLabel" Text="Кем создано" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="0"></TextBlock>
        <TextBlock x:Name="AssignedToLabel" Text="Кому назначено" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="1"></TextBlock>
        <TextBlock x:Name="CategoryLabel" Text="Категория" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="2"></TextBlock>
        <TextBlock x:Name="StatusLabel" Text="Статус" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="3"></TextBlock>
        <TextBlock x:Name="DescriptionLabel" Text="Описание" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="4"></TextBlock>
        <TextBlock x:Name="CreatedDateLabel" Text="Дата создания" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="5"></TextBlock>
        <TextBlock x:Name="UpdatedDateLabel" Text="Дата обновления" VerticalAlignment="Center" FontSize="22" HorizontalAlignment="Center" Grid.Row="6"></TextBlock>
        <ComboBox  x:Name="ComboCreatedBy"  Grid.Column="1"  Grid.Row="0" SelectedValuePath="UserID"
                    DisplayMemberPath="FullName"
                    SelectedValue="{Binding CreatedBy, Mode=TwoWay}" 
                    FontSize="22" />
        <ComboBox  x:Name="ComboAssignedTo"  Grid.Column="1" Grid.Row="1" SelectedValuePath="UserID"
                    DisplayMemberPath="FullName"
                    SelectedValue="{Binding AssignedTo, Mode=TwoWay}" 
                    FontSize="22" />
        <ComboBox  x:Name="ComboCategory" Grid.Column="1"  Grid.Row="2" SelectedValuePath="CategoryID"
                    DisplayMemberPath="CategoryName"
                    SelectedValue="{Binding CategoryID, Mode=TwoWay}" 
                    FontSize="22"></ComboBox>
        <ComboBox x:Name="ComboStatus" Grid.Column="1"  Grid.Row="3" SelectedValuePath="StatusID"
                    DisplayMemberPath="StatusName"
                    SelectedValue="{Binding StatusID, Mode=TwoWay}" 
                    FontSize="22" />
        <TextBox x:Name="Description" Grid.Column="1" Text="{Binding Description}" FontSize="22" Grid.Row="4" MaxLength="100"></TextBox>
        <TextBox x:Name="CreatedDate" Grid.Column="1" Text="{Binding CreatedDate, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="22" Grid.Row="5" MaxLength="100"></TextBox>
        <TextBox x:Name="UpdatedDate" Grid.Column="1" Text="{Binding UpdatedDate, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="22" Grid.Row="6" MaxLength="100"></TextBox>
        <Button Content="Сохранить" Grid.Row="12" FontSize="22" Name="BtnSave" Click="BtnSave_Click" Grid.Column="1" Height="52" Style="{StaticResource ModernOutlinedButton}"/>
        <Button Content="Назад" Grid.Row="12" FontSize="22" Name="BtnBack" Click="BtnBack_Click" Grid.Column="0" Height="52" Style="{StaticResource ModernOutlinedButton}"/>
    </Grid>
</Page>

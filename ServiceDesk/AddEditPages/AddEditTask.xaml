<Page x:Class="ServiceDesk.AddEditPages.AddEditTask"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="430" d:DesignWidth="760"
      Title="AddEditTask"
      Background="#F5F5F5">
    <Border Background="White" CornerRadius="8" Padding="20" Margin="20"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Задача планирования"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1" Text="Название" Height="35" VerticalAlignment="Center" FontSize="19"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TitleBox" Height="35" FontSize="19" MaxLength="150"/>

            <TextBlock Grid.Row="2" Text="Дата" Height="35" VerticalAlignment="Center" FontSize="19" Margin="0,12,0,0"/>
            <DatePicker Grid.Row="2" Grid.Column="1" x:Name="StartDatePicker" FontSize="19" Height="35" Margin="0,12,0,0"/>

            <TextBlock Grid.Row="3" Text="Время" Height="35" VerticalAlignment="Center" FontSize="19" Margin="0,12,0,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="StartTimeBox" Height="35" FontSize="19" Margin="0,12,0,0"
                     MaxLength="5"/>

            <TextBlock Grid.Row="4" Text="Исполнитель" Height="35" VerticalAlignment="Center" FontSize="19" Margin="0,12,0,0"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AssignedToCombo" Height="35" FontSize="19" Margin="0,12,0,0"
                      DisplayMemberPath="FullName" SelectedValuePath="UserID"/>

            <TextBlock Grid.Row="5" Text="Описание" Height="35" VerticalAlignment="Top" FontSize="19" Margin="0,12,0,0"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="DescriptionBox" VerticalAlignment="Top" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" Height="110" FontSize="19" Margin="0,12,0,0"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="500"/>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Назад" Width="120" Height="42" Margin="0,0,10,0"
                        Click="BtnBack_Click" Style="{StaticResource ModernOutlinedButton}"/>
                <Button Content="Сохранить" Width="140" Height="42" FontSize="18" Padding="4"
                        Click="BtnSave_Click" Style="{StaticResource ModernRaisedButton}"
                        Background="#3498DB" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
